# meterboard settings. Copy what you need into your host's environment settings (or a local .env you never commit).
# Every line is optional. With nothing set, meterboard serves invented sample data with no sign-in.

# --- Data source -------------------------------------------------------------
# fixture (sample data, the default) or http (your own usage API, see lib/sources/index.mjs for the answer shape).
METERBOARD_SOURCE=fixture
# fixture only: full (default), unpriced or new.
# METERBOARD_FIXTURE=full
# http only. The key is sent in the header named below and never reaches the browser.
# METERBOARD_HTTP_URL=https://usage-api.example.com/usage
# METERBOARD_HTTP_KEY=replace-with-your-api-key
# METERBOARD_HTTP_KEY_HEADER=x-meterboard-key

# --- Sign-in -----------------------------------------------------------------
# cloudflare-access, token or none. Required when METERBOARD_SOURCE is not fixture.
# WARNING: none lets anyone who can reach the server read your usage.
# METERBOARD_AUTH=token
# token mode: the shared secret people type into the page. Make a long random one, for example: openssl rand -hex 32
# METERBOARD_TOKEN=replace-with-a-long-random-value
# cloudflare-access mode: all three are required, or nobody gets in.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=replace-with-your-access-audience-tag
# CF_ACCESS_ALLOWED_EMAILS=you@example.com
# Where the page's Sign out button goes. Default: the Access sign-out in cloudflare-access mode, none otherwise.
# METERBOARD_SIGN_OUT_URL=/cdn-cgi/access/logout
# The sign-in button text, and the start of the "not signed in" message.
# METERBOARD_SIGN_IN_TEXT=Sign in

# --- MCP server (/api/mcp) -----------------------------------------------------
# Clients send Authorization: Bearer <this>. Unset means /api/mcp refuses everyone.
# METERBOARD_MCP_TOKEN=replace-with-a-long-random-value
# The serverInfo name MCP clients see.
# METERBOARD_MCP_NAME=meterboard

# --- Display -------------------------------------------------------------------
# IANA time zone for "today" and month edges, and how to name it on the page.
# METERBOARD_TIME_ZONE=UTC
# METERBOARD_TIME_ZONE_LABEL=UTC
# METERBOARD_TITLE=AI usage
# Labels for your limit names, as JSON. hosting: true counts an invoice reading as month-to-date hosting dollars.
# METERBOARD_LIMITS={"cloud_month_to_date_usd":{"label":"Cloud spend this month","unit":"usd","hosting":true}}

# --- Local server (npm start) --------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
